# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Settings
# For SQLite (Development)
DATABASE_URL=sqlite:///db.sqlite3

# For MySQL (Production)
# DATABASE_URL=mysql://username:password@localhost:3306/dbname

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Celery Settings
CELERY_BROKER_URL=redis://127.0.0.1:6379
CELERY_RESULT_BACKEND=django-db

# API Settings
SITE_URL=http://127.0.0.1:8000

# Payment Gateway Settings
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# API Endpoints
MEMBER_API_URL=http://127.0.0.1:8080/api/members
CONTRIBUTION_API_URL=http://127.0.0.1:8080/api/contributions

# Notes:
# 1. Replace all placeholder values with your actual configuration
# 2. For Gmail, you need to use an App Password, not your regular password
# 3. In production, set DEBUG=False and use proper security measures
# 4. Keep this file in version control but never commit the actual .env file 
